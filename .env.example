# =============================================================================
# Agency Website — environment template (F14)
# Copy to `.env` for local Vite. Never commit real secrets.
# Server-side Turnstile secret belongs in `.dev.vars` / Cloudflare secrets.
# =============================================================================

# --- Contact / Turnstile (PUBLIC site key only) ---
# Replace with the Agency Turnstile site key before production. Do not reuse
# ADealForge production keys without leadership approval.
VITE_TURNSTILE_SITE_KEY=
VITE_CONTACT_ENDPOINT=/api/contact

# --- Analytics (OPTIONAL — leave empty unless leadership approved GA4) ---
VITE_GA_MEASUREMENT_ID=

# --- Public site origin (REQUIRED before SEO go-live; never adealforge.com) ---
# Used by sitemap/robots generation and release checks.
SITE_ORIGIN=
PUBLIC_SITE_ORIGIN=

# --- F2 studio branding overrides (leave empty while leadership values are TBC) ---
VITE_STUDIO_NAME=
VITE_STUDIO_DOMAIN=
VITE_STUDIO_LOGO_SRC=
VITE_STUDIO_FAVICON_HREF=
VITE_STUDIO_OG_IMAGE_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_MAIL_SUBJECT=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_TWITTER_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SEO_TITLE=
VITE_SEO_DESCRIPTION=
VITE_SEO_SITE_NAME=
VITE_SEO_TWITTER_HANDLE=

# --- Optional contact / CTA surfaces ---
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_DEFAULT_MESSAGE=
VITE_DEMO_VIDEO_URL=
VITE_MEETING_SCHEDULER_URL=
VITE_CALENDLY_URL=
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# --- Post-deploy smoke (optional local/CI tooling) ---
# PRODUCTION_BASE_URL=https://your-approved-agency-domain.example
