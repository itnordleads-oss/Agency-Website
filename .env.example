VITE_TURNSTILE_SITE_KEY=0x4AAAAAADdxXGLk61QWaDnx
VITE_CONTACT_ENDPOINT=/api/contact
# Google Analytics 4 Measurement ID (optional; loaded only after analytics consent)
VITE_GA_MEASUREMENT_ID=
# WhatsApp number for footer social link (digits only, optional country code prefix)
VITE_WHATSAPP_NUMBER=
# Optional product demo video (YouTube, Vimeo, or direct embed URL)
VITE_DEMO_VIDEO_URL=
# Meeting scheduler URL for floating Schedule a Meeting widget (Calendly, HubSpot, Google Appointments, etc.)
VITE_MEETING_SCHEDULER_URL=
# Optional fallback scheduler URL (used when VITE_MEETING_SCHEDULER_URL is empty)
VITE_CALENDLY_URL=
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
