VITE_TURNSTILE_SITE_KEY=0x4AAAAAADdxXGLk61QWaDnx
VITE_CONTACT_ENDPOINT=/api/contact
# Google Analytics 4 Measurement ID (optional; loaded only after analytics consent)
VITE_GA_MEASUREMENT_ID=
# F2 studio branding overrides (leave empty while leadership values are TBC)
VITE_STUDIO_NAME=
VITE_STUDIO_DOMAIN=
VITE_STUDIO_LOGO_SRC=
VITE_STUDIO_FAVICON_HREF=
VITE_STUDIO_OG_IMAGE_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_MAIL_SUBJECT=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_TWITTER_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SEO_TITLE=
VITE_SEO_DESCRIPTION=
VITE_SEO_SITE_NAME=
VITE_SEO_TWITTER_HANDLE=
# WhatsApp number for social link (digits only; unpublished when empty)
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_DEFAULT_MESSAGE=
# Optional product demo video (YouTube, Vimeo, or direct embed URL)
VITE_DEMO_VIDEO_URL=
# Meeting scheduler URL for floating Schedule a Meeting widget (Calendly, HubSpot, Google Appointments, etc.)
VITE_MEETING_SCHEDULER_URL=
# Optional fallback scheduler URL (used when VITE_MEETING_SCHEDULER_URL is empty)
VITE_CALENDLY_URL=
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
